# ========================================
# Application Configuration
# ========================================
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ========================================
# Database (PostgreSQL)
# ========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_NAME=marketing_platform
DATABASE_SSL=false

# ========================================
# Redis
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Optional: Use connection URL instead of individual params
# REDIS_URL=redis://localhost:6379

# ========================================
# RabbitMQ
# ========================================
# Note: Port 5673 to avoid conflict with local RabbitMQ installations
RABBITMQ_URL=amqp://guest:guest@localhost:5673
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=guest

# ========================================
# Queue-based Email Sending (Scalable)
# ========================================
# Enable queue-based email sending for horizontal scaling
# When enabled, emails are processed by workers via RabbitMQ
# When disabled, emails are sent directly (single process)
USE_QUEUED_SENDING=true

# SES Rate Limit (emails per second)
SES_RATE_LIMIT=14

# ========================================
# JWT Authentication
# ========================================
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ========================================
# AWS Configuration
# ========================================
AWS_REGION=us-east-1
AWS_SECRET_ACCESS_KEY=y1MWyOB7kMX8Bx24m5rZ4ixo5E9QVSnnyhZckKID
AWS_ACCESS_KEY_ID=AKIA4IYUFXZB5RNUJIU3
AWS_S3_BUCKET=marketing-platform-uploads

# AWS SES
SES_FROM_EMAIL=info@techvariables.in
SES_FROM_NAME=Marketing Platform
SES_CONFIGURATION_SET=marketing-tracking

# ========================================
# Email Tracking & Security
# ========================================
# Secret key for encrypting tracking tokens (falls back to JWT_ACCESS_SECRET if not set)
# IMPORTANT: Set this in production for better security separation
EMAIL_TRACKING_SECRET=your-email-tracking-secret-min-32-chars

# Salt for key derivation (optional, has default)
EMAIL_TRACKING_SALT=your-custom-salt

# Bounce rate threshold - campaigns pause if exceeded (default: 0.05 = 5%)
EMAIL_BOUNCE_THRESHOLD=0.05

# Complaint rate threshold - campaigns pause if exceeded (default: 0.001 = 0.1%)
EMAIL_COMPLAINT_THRESHOLD=0.001

# Allowed domains for click tracking redirects (comma-separated, optional)
# If set, only redirects to these domains are allowed
# Leave empty to allow all external domains (but internal IPs are always blocked)
ALLOWED_REDIRECT_DOMAINS=

# ========================================
# Twilio (SMS & WhatsApp)
# ========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid

# ========================================
# SendGrid (Backup Email Provider)
# ========================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# ========================================
# Stripe (Payments)
# ========================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs
STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly
STRIPE_PRICE_STARTER_YEARLY=price_starter_yearly
STRIPE_PRICE_GROWTH_MONTHLY=price_growth_monthly
STRIPE_PRICE_GROWTH_YEARLY=price_growth_yearly
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly

# Credit Pricing
STRIPE_PRICE_PER_CREDIT=0.05
TRIAL_CREDITS=100

# ========================================
# Google OAuth
# ========================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ========================================
# Rate Limiting
# ========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ========================================
# Cloudinary (Image Storage)
# ========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========================================
# Sentry (Error Tracking)
# ========================================
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
