# ========================================
# Application Configuration
# ========================================
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ========================================
# Database (PostgreSQL)
# ========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_NAME=marketing_platform
DATABASE_SSL=false
# For production with SSL:
# DATABASE_SSL=true
# DATABASE_CA_CERT=/path/to/rds-ca-bundle.pem

# ========================================
# Redis
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# For production with TLS:
# REDIS_TLS=true

# ========================================
# RabbitMQ
# ========================================
RABBITMQ_URL=amqp://guest:guest@localhost:5673

# ========================================
# Queue-based Email Sending (Scalable)
# ========================================
USE_QUEUED_SENDING=true
SES_RATE_LIMIT=14

# ========================================
# JWT Authentication
# IMPORTANT: Generate strong secrets for production!
# Use: openssl rand -base64 64
# ========================================
JWT_ACCESS_SECRET=your-super-secret-access-key-min-64-chars-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-64-chars-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ========================================
# AWS Configuration
# NEVER commit real credentials!
# Use IAM roles in production or AWS Secrets Manager
# ========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your-s3-bucket-name

# AWS SES
SES_FROM_EMAIL=noreply@yourdomain.com
SES_FROM_NAME=Marketing Platform
SES_CONFIGURATION_SET=marketing-tracking

# ========================================
# Email Tracking & Security
# ========================================
EMAIL_TRACKING_SECRET=your-email-tracking-secret-min-32-chars
EMAIL_TRACKING_SALT=your-custom-salt
EMAIL_BOUNCE_THRESHOLD=0.05
EMAIL_COMPLAINT_THRESHOLD=0.001
ALLOWED_REDIRECT_DOMAINS=

# ========================================
# Twilio (SMS & WhatsApp)
# Get credentials from https://console.twilio.com
# ========================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========================================
# SendGrid (Backup Email Provider)
# ========================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# ========================================
# Stripe (Payments)
# Get from https://dashboard.stripe.com/apikeys
# ========================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_ID_STARTER=price_starter_monthly
STRIPE_PRICE_ID_GROWTH=price_growth_monthly
STRIPE_PRICE_ID_PRO=price_pro_monthly

# Billing Settings
TRIAL_DAYS=14
DEFAULT_CURRENCY=USD
SMS_DEFAULT_PRICE=0.015
EMAIL_DEFAULT_PRICE=0.001
WHATSAPP_DEFAULT_PRICE=0.02
WHATSAPP_CONVERSATION_FEE=0.005

# ========================================
# Google OAuth
# Get from https://console.cloud.google.com
# ========================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ========================================
# Rate Limiting
# ========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ========================================
# Cloudinary (Image Storage)
# ========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========================================
# Sentry (Error Tracking)
# ========================================
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ========================================
# SMS Compliance (Multi-Region)
# ========================================
SMS_COMPLIANCE_ENABLED=true
SMS_COMPLIANCE_STRICT_MODE=false
US_10DLC_ENABLED=true
US_10DLC_REQUIRED=false
EU_COMPLIANCE_ENABLED=true
TWILIO_TEST_MODE=false

# SMS Webhooks
SMS_INBOUND_WEBHOOK_URL=https://your-domain.com/api/webhooks/sms/inbound
SMS_STATUS_CALLBACK_URL=https://your-domain.com/api/webhooks/sms/status

# ========================================
# Testing Configuration
# ========================================
SMS_MOCK_MODE=false
EMAIL_MOCK_MODE=false

# ========================================
# Performance & Scalability Settings
# ========================================
DATABASE_POOL_SIZE=50
DATABASE_POOL_MIN=10
TWILIO_RATE_LIMIT=100
TWILIO_BURST_CAPACITY=150
TWILIO_RATE_LIMIT_ENABLED=true
SMS_RATE_LIMIT=200
